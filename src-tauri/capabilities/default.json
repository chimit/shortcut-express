{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/chimit/shortcut-express" },
        { "url": "https://ko-fi.com/chimit" }
      ]
    }
  ]
}
